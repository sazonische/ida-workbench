# Build trees (build.cmd / build-static.cmd and any hand-made variant) and the
# assembled output they produce.
/build/
/build-*/
/dist/
/dist-*/
/out/

# CMake / clangd / IntelliSense scratch. compile_commands.json is generated by
# CMAKE_EXPORT_COMPILE_COMMANDS, .cache/ is clangd's index.
CMakeUserPresets.json
compile_commands.json
.cache/

# vcpkg: the static Qt is installed into the vcpkg root, never into the repo.
vcpkg_installed/

# Editors and IDEs. .clangd / .clang-format stay tracked — they are project config.
.vscode/
.vs/
.idea/
*.user

# Runtime state of the app. It normally lives in %USERPROFILE%/.ida-workbench/,
# but an export or a copied exe can drop these next to the sources.
/config.json
/ui-state.json
*.log

# OS / editor litter
Thumbs.db
desktop.ini
*~
*.swp
